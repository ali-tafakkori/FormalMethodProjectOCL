        <mxCell id="dysAEP4rozQeLWhS0U_O-53" value="&lt;div&gt;context &lt;b&gt;User&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;-- inv: Username and password cannot be empty.&lt;/div&gt;&lt;div&gt;inv: not username.isEmpty() and not password.isEmpty()&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;-- inv: Password must have at least 8 characters.&lt;/div&gt;&lt;div&gt;inv: password.size() &amp;gt;= 8&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;-- inv: Username must be unique.&lt;/div&gt;&lt;div&gt;inv: User.allInstances()-&amp;gt;forAll(u1, u2 | u1 &amp;lt;&amp;gt; u2 implies u1.username &amp;lt;&amp;gt; u2.username)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;-- pre: Password cannot be empty.&amp;nbsp;&lt;/div&gt;&lt;div&gt;-- post: Logged in if password matches.&lt;/div&gt;&lt;div&gt;context User::login(password: String): Boolean&lt;/div&gt;&lt;div&gt;pre: not password.isEmpty()&lt;/div&gt;&lt;div&gt;post: isLoggedIn = (self.password = password)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;-- pre: Must be logged in.&amp;nbsp;&lt;/div&gt;&lt;div&gt;-- post: Logged out.&lt;/div&gt;&lt;div&gt;context User::logout(): void&lt;/div&gt;&lt;div&gt;pre: isLoggedIn = true&lt;/div&gt;&lt;div&gt;post: isLoggedIn = false&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;align=left;spacingTop=0;spacingLeft=5;" parent="1" vertex="1">
          <mxGeometry x="637" y="164" width="490" height="360" as="geometry" />
        </mxCell>
        <mxCell id="dysAEP4rozQeLWhS0U_O-55" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.004;entryY=0.177;entryDx=0;entryDy=0;entryPerimeter=0;endArrow=none;endFill=0;dashed=1;dashPattern=8 8;" parent="1" source="dysAEP4rozQeLWhS0U_O-19" target="dysAEP4rozQeLWhS0U_O-53" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="dysAEP4rozQeLWhS0U_O-56" value="&lt;div&gt;&lt;div&gt;context &lt;b&gt;OTP&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;-- inv: Code must have at least 6 digits.&lt;/div&gt;&lt;div&gt;inv: code.size() &amp;gt;= 6&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;-- inv: Code must be numeric.&lt;/div&gt;&lt;div&gt;inv: code-&amp;gt;forAll(c | c &amp;gt;= &#39;0&#39; and c &amp;lt;= &#39;9&#39;)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;-- inv: OTP is valid for 5 minutes.&lt;/div&gt;&lt;div&gt;inv: generatedAt.plusMinutes(5) &amp;gt; DateTime::now()&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;-- pre: Input must not be empty.&amp;nbsp;&lt;/div&gt;&lt;div&gt;-- post: True if code matches and is valid.&lt;/div&gt;&lt;div&gt;context OTP::validateOTP(inputCode: String): Boolean&lt;/div&gt;&lt;div&gt;pre: not inputCode.isEmpty()&lt;/div&gt;&lt;div&gt;post: result = (code = inputCode and not isUsed and generatedAt.plusMinutes(5) &amp;gt; DateTime::now())&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;-- pre: OTP must be expired or used.&amp;nbsp;&lt;/div&gt;&lt;div&gt;-- post: New OTP is generated.&lt;/div&gt;&lt;div&gt;context OTP::generateOTP(): String&lt;/div&gt;&lt;div&gt;pre: isUsed or generatedAt.plusMinutes(5) &amp;lt;= DateTime::now()&lt;/div&gt;&lt;div&gt;post: not isUsed and result.size() &amp;gt;= 6&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;align=left;spacingTop=0;spacingLeft=5;" parent="1" vertex="1">
          <mxGeometry x="1130" y="670" width="550" height="360" as="geometry" />
        </mxCell>
        <mxCell id="dysAEP4rozQeLWhS0U_O-58" value="&lt;div&gt;&lt;div&gt;context &lt;b&gt;Admin&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;-- inv: Must have at least one user.&lt;/div&gt;&lt;div&gt;inv: not users-&amp;gt;isEmpty()&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;-- pre: Username and password must not be empty.&amp;nbsp;&lt;/div&gt;&lt;div&gt;-- post: User is created and added.&lt;/div&gt;&lt;div&gt;context Admin::createUser(username: String, password: String): User&lt;/div&gt;&lt;div&gt;pre: not username.isEmpty() and not password.isEmpty()&lt;/div&gt;&lt;div&gt;post: users-&amp;gt;includes(result)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;-- pre: User must exist in the list.&amp;nbsp;&lt;/div&gt;&lt;div&gt;-- post: User is removed.&lt;/div&gt;&lt;div&gt;context Admin::deleteUser(user: User): void&lt;/div&gt;&lt;div&gt;pre: users-&amp;gt;includes(user)&lt;/div&gt;&lt;div&gt;post: not users-&amp;gt;includes(user)&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;align=left;spacingTop=0;spacingLeft=5;" parent="1" vertex="1">
